# ─── Mailtrap Inbound ─────────────────────────────────────────────────────────
# API token from: Mailtrap → Settings → API Tokens (needs the "Admin" scope).
# Used both to fetch inbound messages and to send Melissa's replies.
MAILTRAP_API_TOKEN=your_mailtrap_api_token

# Signing secret of your inbound webhook. Mailtrap signs every delivery with
# HMAC-SHA256 and sends the digest in the `Mailtrap-Signature` header.
# The secret is returned when you create the webhook, and is also shown in
# Mailtrap → Webhooks → your webhook.
MAILTRAP_INBOUND_SECRET=your_inbound_webhook_signing_secret

# ─── Anthropic API ────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional — model used for qualification and website analysis
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Melissa (the AI agent) ───────────────────────────────────────────────────
# Sender address for Melissa's replies. Leave blank for a Mailtrap-hosted
# inbound inbox: those always reply from their own address and the API rejects
# an explicit sender. Set it only for an inbox on your own verified domain.
MELISSA_EMAIL=

# Partner sales address, CC'd on the reply to leads that fall below a threshold
PARTNER_EMAIL=partner@example.com

# URL offered to qualified leads for booking a call
SCHEDULING_LINK=https://example.com/schedule

# ─── Qualification thresholds ─────────────────────────────────────────────────
# A lead must meet all three to be qualified; below any one it is forwarded.
MIN_EMPLOYEES=20
MIN_BUDGET_EUR=1000
MIN_HOURS=20

# ─── HubSpot (optional) ───────────────────────────────────────────────────────
# Private App token from: HubSpot → Settings → Integrations → Private Apps
# Needs the `crm.objects.contacts.write` scope. Leave blank to disable the sync.
HUBSPOT_API_KEY=
