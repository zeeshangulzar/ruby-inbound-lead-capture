<% content_for :title, "Leads — Inbound Lead Capture" %>

<div class="page">
  <header>
    <h1>Inbound Leads</h1>
    <p class="lead">Captured from Mailtrap Inbound, qualified by Melissa (Claude), and routed by verdict.</p>
  </header>

  <% if @leads.empty? %>
    <div class="empty">
      No leads yet. Send an email to your configured Mailtrap Inbound address to see the pipeline in action.
    </div>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>Received</th>
          <th>From</th>
          <th>Company</th>
          <th>Tier</th>
          <th>Score</th>
          <th>Status</th>
          <th>AI replies</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @leads.each do |lead| %>
          <tr>
            <td><%= lead.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <div><%= lead.sender_name.presence || "—" %></div>
              <div class="dim"><%= lead.sender_email %></div>
            </td>
            <td><%= lead.extracted_data["company"].presence || "—" %></td>
            <td>
              <% if lead.tier %>
                <span class="tier tier-<%= lead.tier %>"><%= lead.tier %></span>
              <% else %>
                <span class="dim">pending</span>
              <% end %>
            </td>
            <td><%= lead.score || "—" %></td>
            <td><%= lead.status.humanize %></td>
            <td><%= lead.ai_reply_count %> / <%= Lead::MAX_AI_REPLIES %></td>
            <td><%= link_to "View", lead_path(lead) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; background: #f6f6f6; margin: 0; padding: 32px 24px; color: #222; }
  .page { max-width: 1080px; margin: 0 auto; }
  h1 { margin: 0 0 4px 0; }
  .lead { color: #666; margin: 0 0 24px 0; }
  .empty { background: #fff; padding: 32px; border-radius: 8px; text-align: center; color: #666; }
  table { width: 100%; background: #fff; border-radius: 8px; border-collapse: collapse; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.05); }
  th, td { text-align: left; padding: 12px 16px; border-bottom: 1px solid #eee; font-size: 14px; }
  th { background: #fafafa; font-weight: 600; color: #444; font-size: 13px; text-transform: uppercase; letter-spacing: 0.4px; }
  tbody tr:last-child td { border-bottom: none; }
  .dim { color: #888; font-size: 13px; }
  .tier { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
  .tier-hot       { background: #fee2e2; color: #b91c1c; }
  .tier-warm      { background: #fef3c7; color: #92400e; }
  .tier-cold      { background: #dbeafe; color: #1e40af; }
  .tier-forwarded { background: #e5e7eb; color: #374151; }
  .tier-red_flag  { background: #111; color: #fff; }
  a { color: #635bff; text-decoration: none; font-weight: 600; }
  a:hover { text-decoration: underline; }
</style>
